<?xml version="1.0" encoding="utf-8"?>
<!--
    Pill-shaped background used to flag a match as "Active" in the matches
    list. Soft mint green (#D1E7DD) with a slightly darker stroke so the badge
    stays readable in both light and dark mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#D1E7DD" />
    <stroke
        android:width="1dp"
        android:color="#198754" />
    <corners android:radius="999dp" />
</shape>
