<?xml version="1.0" encoding="utf-8"?>
<!--
    Pill-shaped background used to flag a match as "Expired" — neutral grey
    so it visually recedes compared to the green "Active" badge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E5E7EB" />
    <stroke
        android:width="1dp"
        android:color="#6B7280" />
    <corners android:radius="999dp" />
</shape>
