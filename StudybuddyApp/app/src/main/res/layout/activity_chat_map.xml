<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.map.ChatMapActivity">

    <!--
        Header bar showing the title of the chat plus a small subtitle
        summarising how many participants are currently displayed.
        Kept above the MapView so it doesn't get hidden by Mapbox controls.
    -->
    <LinearLayout
        android:id="@+id/header_chat_map"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_chat_map_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chat_map_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_map_title"
                android:textColor="#1A1A3E"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Chat with Alice" />

            <TextView
                android:id="@+id/tv_chat_map_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_map_loading"
                android:textColor="#888888"
                android:textSize="12sp"
                tools:text="2 participants located" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Mapbox map view filling the rest of the screen. The view itself is
        responsible for handling rotation: we save / restore camera state in
        ChatMapViewModel so the user does not lose their context.
    -->
    <com.mapbox.maps.MapView
        android:id="@+id/chat_map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_chat_map" />

</androidx.constraintlayout.widget.ConstraintLayout>
