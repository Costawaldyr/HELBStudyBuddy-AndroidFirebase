<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="32dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New AI Buddy"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1a1a3e"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personalize your AI assistant"
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp" />

    <!-- Avatar picker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avatar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5B4FCF"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Avatar sélectionné + bouton photo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Avatar actuel -->
            <FrameLayout
                android:id="@+id/frame_avatar_preview"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/iv_selected_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_robot"
                    android:padding="0dp"
                    android:background="@android:color/transparent" />

                <ImageView
                    android:id="@+id/img_buddy_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_avatar_circle"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Boutons choix -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_photo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Choose a custom photo"
                    android:textSize="12sp"
                    android:textColor="#5B4FCF"
                    app:strokeColor="#5B4FCF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_camera" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Or use course emoji (automatic)"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hidden Emoji grid (Removed icons as requested) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_emoji_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#F8F7FF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Buddy Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buddy Name"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5B4FCF"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: Algo Bot, Java Master..."
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#5B4FCF"
            app:hintTextColor="#5B4FCF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_buddy_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Course -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Specialized Course"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#5B4FCF"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#5B4FCF"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F8F7FF">

            <Spinner
                android:id="@+id/spinner_course"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Preview card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#1a1a3e"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_preview_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_robot"
                android:padding="10dp"
                app:tint="#FFFFFF"
                android:background="@drawable/bg_circle_white_alpha"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_preview_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Buddy"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preview_course"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No course selected"
                    android:textColor="#AAAACC"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#6C47FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_ready"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Create button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_buddy"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="Create my Buddy"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#5B4FCF"
        app:cornerRadius="14dp"
        app:elevation="4dp" />

    <ProgressBar
        android:id="@+id/progress_create"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

</LinearLayout>