<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ── CARTE PLEIN ÉCRAN ── -->
    <com.mapbox.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:mapbox_cameraTargetLat="50.8503"
        app:mapbox_cameraTargetLng="4.3517"
        app:mapbox_cameraZoom="13" />

    <!-- ── BARRE DE TITRE ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E61A1A3E"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_recenter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_my_location"
            android:background="@drawable/circle_white_alpha"
            android:padding="10dp"
            app:tint="#FFFFFF"
            android:contentDescription="@string/map_recenter" />
    </LinearLayout>

    <!-- ── PANNEAU D'INFO ── -->
    <LinearLayout
        android:id="@+id/panel_spot_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:padding="24dp"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_spot_type"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_location"
                app:tint="#3949AB"
                android:background="@drawable/bg_avatar_circle"
                android:padding="10dp"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_spot_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_spot_name_placeholder"
                    android:textColor="#1a1a3e"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_spot_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_address_placeholder"
                    android:textColor="#757575"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close_panel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:padding="6dp"
                app:tint="#BDBDBD" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_study_here"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/map_go_directions"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#3949AB" />

    </LinearLayout>

    <!-- ── FAB Ma position ── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="@string/map_my_location"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="#FF6D00"
        app:tint="#FFFFFF" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>