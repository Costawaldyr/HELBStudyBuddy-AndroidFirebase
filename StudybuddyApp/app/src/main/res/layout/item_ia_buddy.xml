<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!--
            Avatar shown on the left of every buddy card. Two views layered
            in a FrameLayout — one wins at runtime depending on whether the
            buddy has a course emoji available:
              • tv_buddy_emoji → big emoji of the course (📚 / 🧮 / 💻…)
              • iv_buddy_icon  → robot fallback when no emoji
        -->
        <FrameLayout
            android:id="@+id/buddy_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_decoration">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_buddy_real_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_buddy_emoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="28sp"
                android:visibility="gone"
                tools:text="📚" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_buddy_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_robot"
                app:tint="#3949AB" />
        </FrameLayout>

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_buddy_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Algo Bot"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1a1a3e" />

            <TextView
                android:id="@+id/tv_buddy_specialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/specialized_subject"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp" />

            <!-- Chips des matières -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/layout_subjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:flexDirection="row"
                app:justifyContent="flex_start" />
        </LinearLayout>

        <!-- Statut et bouton chat -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_buddy_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/online_status"
                android:textSize="11sp"
                android:textColor="#4CAF50"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="20dp"
                android:textColor="#3949AB"
                app:strokeColor="#3949AB" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>