<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: status badge (Active / Expired) on the left, expiry timer on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_match_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/match_status_active"
                android:textColor="#0F5132"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_expiry_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24h"
                android:textSize="12sp"
                android:textColor="#FF6B35"
                android:background="#FFF3E8"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:drawableStart="@drawable/ic_timer"
                android:drawablePadding="4dp" />
        </LinearLayout>

        <!-- Info utilisateur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Avatar avec initiales -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_match_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_profile"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_match_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alice"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1a1a3e" />

                <TextView
                    android:id="@+id/tv_match_school"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HELB B2"
                    android:textSize="12sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/tv_match_subject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Algo"
                    android:textSize="13sp"
                    android:textColor="#3949AB"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_match_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Library"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="4dp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Bouton chat -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_match_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_button"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:backgroundTint="#3949AB"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>