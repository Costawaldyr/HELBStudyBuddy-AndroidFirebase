<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboard_menu">

    <fragment
        android:id="@+id/dashboard_menu"
        android:name="com.example.studybuddy.fragments.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/messages_fragment"
        android:name="com.example.studybuddy.fragments.MessageListFragment"
        android:label="Messages"
        tools:layout="@layout/fragment_message_list" />

    <fragment
        android:id="@+id/map_menu"
        android:name="com.example.studybuddy.fragments.MapFragment"
        android:label="Map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/profile_menu"
        android:name="com.example.studybuddy.fragments.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settings_fragment" />
    </fragment>

    <fragment
        android:id="@+id/settings_fragment"
        android:name="com.example.studybuddy.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/buddies_menu"
        android:name="com.example.studybuddy.fragments.BuddyListFragment"
        android:label="Matches"
        tools:layout="@layout/fragment_buddy_list" />
</navigation>
